{
  "name": "cc-hpe-browser-3dgs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prepare:assets": "node scripts/prepare-runtime-assets.mjs",
    "build": "npm run prepare:assets && tsc -b && vite build",
    "verify:pages": "node scripts/verify-pages-build.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "node scripts/prepare-runtime-assets.mjs --body-only && vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"*.{ts,json,md}\""
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "spz-js": "^1.2.5",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/three": "^0.180.0",
    "fbx2gltf": "^0.9.7-p1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
